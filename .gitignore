# Build output. Regenerated by ./build.sh — never commit binaries.
# Note: assets/ is deliberately NOT ignored. The README images live there
# precisely because anything under build/ would be invisible to GitHub.
build/

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors
*.swp
*~
.vscode/
.idea/

# Swift / Xcode, in case a project file is ever added
.swiftpm/
DerivedData/
*.xcuserdatad/
xcuserdata/
*.moved-aside

# Throwaway probes. The project's habit is to compile small programs into /tmp
# to measure what an AppKit call really does; those are not part of the repo.
probe-*

# The app icon is generated, not committed. build.sh rebuilds it when it is
# missing or older than Tools/MakeIcon.swift, so a clone needs no icon in the
# tree. This rule is what makes README.md's "generated, not committed" true.
Resources/*.icns

# Brainstorm session state contains bearer tokens and should never be committed
.superpowers/brainstorm/

# Launch-video output from the /brag command. Large media, regenerable.
brag-output/
